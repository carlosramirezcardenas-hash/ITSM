{
  "name": "itsm-easy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "postinstall": "prisma generate",
    "vercel-build": "bash scripts/vercel-build.sh",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "tsx tests/e2e/smoke.ts",
    "test:e2e:2": "tsx tests/e2e/phase2.ts",
    "test:e2e:3": "tsx tests/e2e/phase3.ts",
    "test:e2e:x": "tsx tests/e2e/experience.ts",
    "mock:anthropic": "tsx tests/mock-anthropic.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "next": "^15.5.29",
    "react": "^19.1.10",
    "react-dom": "^19.1.10",
    "recharts": "^2.15.4",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
