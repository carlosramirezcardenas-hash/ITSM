// ITSM Easy — modelo de datos (Fase 1 / MVP)
// Multi-tenant: base de datos compartida, aislamiento por columna `orgId`
// en todas las entidades de negocio. Ver docs/ARCHITECTURE.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN      // Superadministrador SaaS (sin organización)
  ORG_ADMIN        // Administrador de organización
  SERVICE_MANAGER  // Gestor de servicios
  AGENT            // Agente de soporte
  APPROVER         // Aprobador
  END_USER         // Usuario final
}

enum TicketType {
  INCIDENT // "Tengo un problema"
  REQUEST  // "Quiero solicitar algo"
}

enum TicketStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  PENDING
  RESOLVED
  CLOSED
}

enum Level {
  LOW
  MEDIUM
  HIGH
}

enum Priority {
  P1 // Crítica
  P2 // Alta
  P3 // Media
  P4 // Baja
}

enum ApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

model Organization {
  id         String   @id @default(cuid())
  name       String
  slug       String   @unique
  plan       String   @default("starter")
  timezone   String   @default("America/Santiago")
  ticketSeq  Int      @default(1000)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  users         User[]
  departments   Department[]
  teams         Team[]
  categories    Category[]
  services      ServiceItem[]
  slaPolicies   SlaPolicy[]
  calendars     BusinessCalendar[]
  tickets       Ticket[]
  articles      KbArticle[]
  notifications Notification[]
  auditLogs     AuditLog[]
}

model User {
  id             String    @id @default(cuid())
  orgId          String?
  org            Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email          String    @unique
  name           String
  passwordHash   String
  role           Role      @default(END_USER)
  title          String?
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  managerId      String?
  manager        User?     @relation("Manager", fields: [managerId], references: [id], onDelete: SetNull)
  reports        User[]    @relation("Manager")
  isActive       Boolean   @default(true)
  failedLogins   Int       @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  sessions         Session[]
  resetTokens      PasswordResetToken[]
  memberships      TeamMember[]
  requested        Ticket[]   @relation("Requester")
  assigned         Ticket[]   @relation("Assignee")
  comments         TicketComment[]
  activities       TicketActivity[]
  approvals        Approval[]
  notifications    Notification[]
  ownedServices    ServiceItem[] @relation("ServiceOwner")
  approverServices ServiceItem[] @relation("ServiceApprover")
  articles         KbArticle[]
  articleFeedback  KbFeedback[]

  @@index([orgId, role])
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Department {
  id    String @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name  String
  users User[]

  @@unique([orgId, name])
}

model Team {
  id          String @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  description String?
  autoAssign  Boolean @default(true)
  createdAt   DateTime @default(now())

  members    TeamMember[]
  tickets    Ticket[]
  categories Category[]
  services   ServiceItem[]

  @@unique([orgId, name])
}

model TeamMember {
  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  isLead Boolean @default(false)

  @@id([teamId, userId])
}

model Category {
  id        String   @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String
  icon      String   @default("folder")
  color     String   @default("slate")
  keywords  String[] // usadas por la clasificación automática
  teamId    String?
  team      Team?    @relation(fields: [teamId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  services ServiceItem[]
  tickets  Ticket[]
  articles KbArticle[]

  @@unique([orgId, name])
}

// Elemento del catálogo de servicios
model ServiceItem {
  id               String   @id @default(cuid())
  orgId            String
  org              Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name             String
  description      String
  icon             String   @default("package")
  categoryId       String?
  category         Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  estimatedHours   Int      @default(24)
  requirements     String?
  // [{ key, label, type: text|textarea|select|date|number, required, options[], sensitive }]
  formSchema       Json     @default("[]")
  requiresApproval Boolean  @default(false)
  // "MANAGER" = jefe directo del solicitante; "USER" = aprobador fijo
  approvalMode     String   @default("MANAGER")
  approverId       String?
  approver         User?    @relation("ServiceApprover", fields: [approverId], references: [id], onDelete: SetNull)
  ownerTeamId      String?
  ownerTeam        Team?    @relation(fields: [ownerTeamId], references: [id], onDelete: SetNull)
  ownerId          String?
  owner            User?    @relation("ServiceOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  defaultPriority  Priority @default(P3)
  isActive         Boolean  @default(true)
  popularity       Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tickets Ticket[]
}

model BusinessCalendar {
  id        String   @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String
  timezone  String   @default("America/Santiago")
  workDays  Int[]    // 0=domingo ... 6=sábado
  startTime String   @default("09:00")
  endTime   String   @default("18:00")
  is24x7    Boolean  @default(false)
  holidays  Holiday[]
  policies  SlaPolicy[]
}

model Holiday {
  id         String   @id @default(cuid())
  calendarId String
  calendar   BusinessCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  date       String   // YYYY-MM-DD en la zona horaria del calendario
  name       String

  @@unique([calendarId, date])
}

model SlaPolicy {
  id                String   @id @default(cuid())
  orgId             String
  org               Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name              String
  priority          Priority
  responseMinutes   Int
  resolutionMinutes Int
  calendarId        String?
  calendar          BusinessCalendar? @relation(fields: [calendarId], references: [id], onDelete: SetNull)
  warnPercent       Int      @default(75) // alerta al consumir este % del tiempo
  isActive          Boolean  @default(true)

  tickets Ticket[]

  @@unique([orgId, priority])
}

model Ticket {
  id              String         @id @default(cuid())
  orgId           String
  org             Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  number          Int
  type            TicketType
  title           String
  description     String
  status          TicketStatus   @default(NEW)
  pendingReason   String?
  impact          Level          @default(LOW)
  urgency         Level          @default(LOW)
  priority        Priority       @default(P4)
  channel         String         @default("portal")
  categoryId      String?
  category        Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  serviceItemId   String?
  serviceItem     ServiceItem?   @relation(fields: [serviceItemId], references: [id], onDelete: SetNull)
  formData        Json?          // respuestas del formulario (campos sensibles cifrados)
  requesterId     String
  requester       User           @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  assigneeId      String?
  assignee        User?          @relation("Assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  teamId          String?
  team            Team?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  approvalStatus  ApprovalStatus @default(NOT_REQUIRED)

  // SLA
  slaPolicyId     String?
  slaPolicy       SlaPolicy?     @relation(fields: [slaPolicyId], references: [id], onDelete: SetNull)
  responseDueAt   DateTime?
  resolutionDueAt DateTime?
  firstResponseAt DateTime?
  slaPausedAt     DateTime?
  slaPausedMinutes Int           @default(0)
  responseBreached   Boolean     @default(false)
  resolutionBreached Boolean     @default(false)
  slaWarned       Boolean        @default(false)
  escalationLevel Int            @default(0)

  resolution      String?
  resolvedAt      DateTime?
  closedAt        DateTime?
  reopenCount     Int            @default(0)
  csatScore       Int?
  csatComment     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  comments   TicketComment[]
  activities TicketActivity[]
  approvals  Approval[]

  @@unique([orgId, number])
  @@index([orgId, status])
  @@index([orgId, assigneeId])
  @@index([orgId, requesterId])
  @@index([orgId, createdAt])
}

model TicketComment {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  body       String
  isInternal Boolean  @default(false) // nota interna, no visible para el usuario final
  createdAt  DateTime @default(now())

  @@index([ticketId])
}

model TicketActivity {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    String   // created, status, assigned, priority, escalated, approval, comment, reopened, csat
  fromValue String?
  toValue   String?
  note      String?
  createdAt DateTime @default(now())

  @@index([ticketId])
}

model Approval {
  id         String         @id @default(cuid())
  ticketId   String
  ticket     Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  approverId String
  approver   User           @relation(fields: [approverId], references: [id], onDelete: Cascade)
  status     ApprovalStatus @default(PENDING)
  comment    String?
  decidedAt  DateTime?
  createdAt  DateTime       @default(now())

  @@index([approverId, status])
}

model KbArticle {
  id         String        @id @default(cuid())
  orgId      String
  org        Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  title      String
  slug       String
  summary    String
  body       String        // texto con pasos; líneas "1. ..." se muestran como paso a paso
  categoryId String?
  category   Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags       String[]
  isFaq      Boolean       @default(false)
  status     ArticleStatus @default(PUBLISHED)
  views      Int           @default(0)
  helpfulYes Int           @default(0)
  helpfulNo  Int           @default(0)
  authorId   String?
  author     User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  feedback KbFeedback[]

  @@unique([orgId, slug])
}

model KbFeedback {
  articleId String
  article   KbArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  helpful   Boolean
  createdAt DateTime  @default(now())

  @@id([articleId, userId])
}

model Notification {
  id        String    @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String    @default("info") // info | success | warning | danger
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  orgId     String?
  org       Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actorId   String?
  actorName String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([orgId, createdAt])
}
